# Copiar a .env.local y completar con los valores reales.
# En producción usar el connection string de Supabase:
# - DATABASE_URL: pooler de Supabase (puerto 6543, transaction mode)
# - DIRECT_URL: conexión directa (puerto 5432) para migraciones Drizzle

DATABASE_URL="postgresql://usuario:password@127.0.0.1:5432/natillera"
DIRECT_URL="postgresql://usuario:password@127.0.0.1:5432/natillera"

BETTER_AUTH_SECRET="generar-con-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Credenciales de la semilla demo (solo desarrollo)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_SOCIO_USERNAME="socio"
SEED_SOCIO_PASSWORD="Socio123!"
