# Copiar a .env.local y completar con los valores reales.
# Base de datos: Supabase PostgreSQL (dashboard del proyecto → Connect).
# - DATABASE_URL: transaction pooler de Supabase (puerto 6543, modo transaction)
# - DIRECT_URL: session pooler o conexión directa (puerto 5432) para migraciones

DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

BETTER_AUTH_SECRET="generar-con-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Credenciales de la semilla demo (solo desarrollo)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_SOCIO_USERNAME="socio"
SEED_SOCIO_PASSWORD="Socio123!"
